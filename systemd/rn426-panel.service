# Reference systemd unit for the RN426 front-panel driver.
#
# NOTE: On TrueNAS SCALE the root filesystem (including /etc/systemd) is reset on
# updates, so a unit file here will NOT survive. Use ../install.sh instead, which
# registers the daemon as a POSTINIT init script in the TrueNAS config DB (that
# persists across reboots and updates).
#
# This unit is reference-only for TrueNAS SCALE users, but is the actual, intended
# install path for plain Debian / OpenMediaVault systems on the same hardware.
# See docs/debian-omv.md for full install steps. Adjust the path in ExecStart
# to wherever you placed rn426_panel.py.

[Unit]
Description=ReadyNAS RN426 front-panel driver (LCD + buttons)
After=multi-user.target

[Service]
Type=simple
ExecStartPre=-/sbin/modprobe i2c-dev
ExecStartPre=-/sbin/modprobe i2c-i801
ExecStart=/usr/bin/python3 /opt/rn426-panel/rn426_panel.py run
Restart=always
RestartSec=10
Environment=RN_SLEEP=90

[Install]
WantedBy=multi-user.target
